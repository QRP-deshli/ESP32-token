# Let the logged-in desktop user open the virtual FIDO device created by ctaphid_serial_bridge.py
# (browsers cannot use /dev/hidrawN while it is root-only). VID:PID 1d50:619b, HID parent "0003:1D50:619B.xxxx".
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="0003:1D50:619B.*", MODE="0660", TAG+="uaccess"
